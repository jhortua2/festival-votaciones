# Copie este archivo como ".env" y ponga sus datos. El archivo .env NO se sube a GitHub.

# --- Base de datos MySQL ---
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Para probar sin MySQL, cambie la primera línea por:  DB_ENGINE=sqlite

# --- Django ---
DJANGO_DEBUG=
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
