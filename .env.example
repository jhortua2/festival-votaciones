# Copie este archivo como ".env" y ponga sus datos. El archivo .env NO se sube a GitHub.

# --- Base de datos MySQL ---
DB_ENGINE=mysql
DB_NAME=festival_votaciones
DB_USER=festival
DB_PASSWORD=escriba_aqui_la_clave_del_usuario_festival
DB_HOST=127.0.0.1
DB_PORT=3306

# Para probar sin MySQL, cambie la primera línea por:  DB_ENGINE=sqlite

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# --- Servidor público ---
# En Vercel estas variables se ponen en la configuración del proyecto, no en un archivo.
# Ver docs/DESPLIEGUE.md. Nunca reutilice aquí las claves del PC ni las del README.
# DJANGO_DEBUG=0
# DJANGO_HTTPS=1
# DJANGO_SECRET_KEY=una-clave-larga-y-aleatoria-distinta-a-la-del-PC
# DJANGO_CACHE_DB=1
# DB_SSL=1          (base MySQL en la nube con conexión cifrada, por ejemplo TiDB Cloud)
# DEMO_CLAVE_ADMIN=...   DEMO_CLAVE_JURADO=...   DEMO_CLAVE_VOTANTE=...
