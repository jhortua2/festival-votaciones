# Copie este archivo como ".env" y ponga sus datos. El archivo .env NO se sube a GitHub.

# --- Base de datos MySQL ---
DB_ENGINE=mysql
DB_NAME=festival_votaciones
DB_USER=festival
DB_PASSWORD=escriba_aqui_la_clave_del_usuario_festival
DB_HOST=127.0.0.1
DB_PORT=3306

# Para probar sin MySQL, cambie la primera línea por:  DB_ENGINE=sqlite

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria


# --- Correo para "¿Olvidaste tu contraseña?" (opcional) ---
# Si se dejan vacíos, el enlace de recuperación se muestra en la terminal del servidor (modo de prueba).
# Para Gmail: activar la verificación en dos pasos y crear una "contraseña de aplicación" (16 letras).
# Nunca suba la clave real a GitHub: solo va en su .env.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
